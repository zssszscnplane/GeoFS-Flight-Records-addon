    // Collect inputs and export as JSON
    function exportRecordsToJSON() {
        var data = {
            meta: {
                exportedAt: new Date().toISOString(),
                source: 'GeoFS Flight Records Addon'
            },
            flight: {
                from: fromInput.value || '',
                destination: destinationInput.value || '',
                flightNumber: flightnumberInput.value || ''
            },
            timeline: [
                { key: 'boarding', value: boardtimeInput.value || '' },
                { key: 'taxi_before_takeoff', value: taxitimeInput.value || '' },
                { key: 'takeoff', value: takeofftimeInput.value || '' },
                { key: 'cruise', value: cruisetimeInput.value || '' },
                { key: 'landing', value: landingtimeInput.value || '' },
                { key: 'taxi_after_landing', value: taxi2timeInput.value || '' },
                { key: 'parking', value: parkingtimeInput.value || '' },
                { key: 'deplane', value: deplanetimeInput.value || '' }
            ]
        };

        var jsonStr = JSON.stringify(data, null, 2);
        var blob = new Blob([jsonStr], { type: 'application/json' });
        var url = URL.createObjectURL(blob);

        var filenameBase = 'geoFS_flight';
        if (flightnumberInput.value) {
            // sanitize filename part
            var fn = flightnumberInput.value.replace(/[^a-zA-Z0-9-_]/g, '_');
            filenameBase += '_' + fn;
        }
        var timestamp = new Date().toISOString().slice(0,19).replace(/[:T]/g, '-');
        var filename = filenameBase + '_' + timestamp + '.json';

        var a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function() { URL.revokeObjectURL(url); }, 1000);
        statusDiv.textContent = languageMap[currentLanguage]['Exported: '] + filename;
    }

    exportButton.addEventListener('click', function() {
        exportRecordsToJSON();
    });

    // Populate UI from imported data
    function populateFromData(data) {
        if (!data || typeof data !== 'object') throw new Error('invalid data');

        // flight field support (compatible with older/newer formats)
        if (data.flight && typeof data.flight === 'object') {
            fromInput.value = data.flight.from || '';
            destinationInput.value = data.flight.destination || '';
            flightnumberInput.value = data.flight.flightNumber || data.flight.flightNo || data.flight.flight || '';
        }

        // timeline: support array [{key,value}] or object { "boarding":"1600", ... }
        if (Array.isArray(data.timeline)) {
            data.timeline.forEach(function(item) {
                if (!item || typeof item !== 'object') return;
                var k = (item.key || '').toString();
                var v = (item.value || '').toString();
                assignTimelineValue(k, v);
            });
        } else if (data.timeline && typeof data.timeline === 'object') {
            Object.keys(data.timeline).forEach(function(k) {
                assignTimelineValue(k, data.timeline[k]);
            });
        }

        // support root-level keys in both English and Chinese
        var directMap = {
            'boarding': 'board-time-Input',
            'taxi_before_takeoff': 'taxi-time-Input',
            'takeoff': 'take-off-time-Input',
            'cruise': 'cruise-time-Input',
            'landing': 'landing-time-Input',
            'taxi_after_landing': 'taxi-2-time-Input',
            'parking': 'parking-time-Input',
            'deplane': 'deplane-time-Input',
            '上机': 'board-time-Input',
            '起飞前滑行': 'taxi-time-Input',
            '起飞': 'take-off-time-Input',
            '巡航': 'cruise-time-Input',
            '降落': 'landing-time-Input',
            '降落后滑行': 'taxi-2-time-Input',
            '停机': 'parking-time-Input',
            '下机': 'deplane-time-Input'
        };
        Object.keys(directMap).forEach(function(k) {
            if (data.hasOwnProperty(k)) {
                document.getElementById(directMap[k]).value = data[k] || '';
            }
        });
    }

    function assignTimelineValue(key, value) {
        if (!key) return;
        var rawKey = key.toString().trim();
        var keyLower = rawKey.toLowerCase();
        var v = value == null ? '' : value.toString();
        switch (keyLower) {
            case '上机':
            case 'boarding':
            case 'board':
                boardtimeInput.value = v;
                break;
            case '起飞前滑行':
            case 'taxi_before_takeoff':
            case 'taxi_before':
                taxitimeInput.value = v;
                break;
            case '起飞':
            case 'takeoff':
                takeofftimeInput.value = v;
                break;
            case '巡航':
            case 'cruise':
                cruisetimeInput.value = v;
                break;
            case '降落':
            case 'landing':
                landingtimeInput.value = v;
                break;
            case '降落后滑行':
            case 'taxi_after_landing':
                taxi2timeInput.value = v;
                break;
            case '停机':
            case 'parking':
                parkingtimeInput.value = v;
                break;
            case '下机':
            case 'deplane':
            case 'disembark':
                deplanetimeInput.value = v;
                break;
            default:
                console.log('Unknown timeline key:', rawKey, 'value:', v);
        }
    }

    // File selection and import handling
    fileInput.addEventListener('change', function(evt) {
        var file = fileInput.files && fileInput.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function(e) {
            try {
                var text = e.target.result;
                var parsed = JSON.parse(text);
                populateFromData(parsed);
                statusDiv.textContent = languageMap[currentLanguage]['Import success'];
            } catch (err) {
                console.error(err);
                statusDiv.textContent = languageMap[currentLanguage]['Import failed: invalid JSON or structure'];
                alert(languageMap[currentLanguage]['Import failed: invalid JSON or structure']);
            } finally {
                // Clear input so selecting same file again will trigger change
                fileInput.value = '';
            }
        };
        reader.onerror = function(err) {
            console.error('File read error', err);
            statusDiv.textContent = languageMap[currentLanguage]['Import failed: invalid JSON or structure'];
            fileInput.value = '';
        };
        reader.readAsText(file, 'utf-8');
    });

